# QALLM environment configuration.
#
# Copy this file to .env and fill in the values you need:
#     cp .env.example .env
#
# At least one LLM provider must be configured (OPENAI_API_KEY,
# ANTHROPIC_API_KEY, or the Ollama compose profile for local models).
# All other variables are optional and have sensible defaults.

# ---------- LLM providers ----------

# OpenAI. Required if you want to use OpenAI models (gpt-4o-mini,
# gpt-5-mini, etc.). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Anthropic. Required if you want to use Claude models.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (local LLM). Pick ONE of these depending on where Ollama runs:
#
#   Host Ollama (macOS / Windows), reached from inside the container:
#     OLLAMA_BASE_URL=http://host.docker.internal:11434
#
#   Containerised Ollama (started via `docker compose --profile with-ollama up`):
#     leave OLLAMA_BASE_URL unset; compose defaults to http://ollama:11434
#
#   Local install (no Docker):
#     OLLAMA_BASE_URL=http://localhost:11434  (or omit; this is the default)
#
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b

# ---------- Budget ----------

# Soft cap on total LLM tokens per session. The orchestrator stops the
# RL loop early if exceeded. Increase for full-scale experiments.
TOKEN_BUDGET=500000

# ---------- Ports (optional) ----------

# Host port the API binds to. Visit http://localhost:${API_PORT} to use
# the web UI once docker compose is up.
API_PORT=8000

# Host port for the optional Ollama service. Only relevant with the
# with-ollama profile.
OLLAMA_PORT=11434
# ---------- SonarQube (optional) ----------

# Optional higher-fidelity static analysis. Leave unset to run on
# Radon/Bandit only. To enable the in-stack server:
#   docker compose --profile sonarqube up
# then create a token at http://localhost:${SONARQUBE_PORT} (admin/admin
# on first login) and set SONARQUBE_TOKEN below.
# SONARQUBE_URL=http://sonarqube:9000
# SONARQUBE_TOKEN=
# For SonarCloud instead of the self-hosted server:
#   SONARQUBE_URL=https://sonarcloud.io
#   SONARQUBE_ORGANIZATION=your-org-key
SONARQUBE_PORT=9000

# Bake the SonarQube scanner CLI into the api image. Required for the
# SonarQube analyzer to actually run (without it, the analyzer no-ops and
# the pipeline falls back to Radon/Bandit). Adds a JRE (~200MB), so it is
# off by default. Set to 1 and rebuild: docker compose build api
WITH_SONAR_SCANNER=0
