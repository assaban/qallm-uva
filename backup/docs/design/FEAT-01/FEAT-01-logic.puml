@startuml
!define STAGE1 #DDEEFF
!define STAGE2 #FFF2CC
!define STAGE3 #F8CECC

skinparam sequence {
    ParticipantBackgroundColor STAGE1
    ParticipantBorderColor #0066CC
    LifeLineBackgroundColor #F5F5F5
}

title FEAT-01: Unified Ingestion Logic (Colorful)

participant "Jupyter Adapter" as JA << (S,STAGE1) >>
participant "Magic Stripper" as MS << (S,STAGE1) >>
participant "CodeUnit" as CU << (O,STAGE1) >>

[-> JA : parse_notebook(path)
activate JA STAGE1

JA -> JA : Load JSON schema
loop for each cell in notebook
    alt cell_type == "code"
        JA -> MS : clean(source)
        activate MS STAGE1
        MS -> MS : Regex replace ("^%.*")
        MS -> MS : Regex replace ("^!.*")
        MS --> JA : cleaned_source
        deactivate MS

        JA -> CU : new(source, cell_index)
        activate CU STAGE1
        CU --> JA : unit_instance
        deactivate CU
    end
end

[<-- JA : List<CodeUnit>
deactivate JA
@enduml