@startuml
!define STAGE2 #FFF2CC

skinparam sequence {
    ParticipantBackgroundColor STAGE2
    ParticipantBorderColor #D4A017
    LifeLineBackgroundColor #F5F5F5
}

title FEAT-02: QQE Logic (Yellow)

participant "Orchestrator" as ORC
participant "StaticAnalyzer" as SA << (S,STAGE2) >>
participant "Subprocess Wrapper" as SW << (T,STAGE2) >>

ORC -> SA : analyze(units: List<CodeUnit>)
activate SA STAGE2

loop for each CodeUnit
    SA -> SW : run_radon(source)
    activate SW STAGE2
    SW --> SA : {mi, cc}
    deactivate SW

    SA -> SW : run_bandit(source)
    activate SW STAGE2
    SW --> SA : {vulnerabilities}
    deactivate SW
end

SA --> ORC : Consolidated Report
deactivate SA
@enduml