@startuml
title qallm-uva: Thesis Core Architecture (RL-Verification)

package "Stage 1: Preprocessing" {
    [Jupyter Adapter] as JA
}

package "Stage 2: Static Analysis" {
    [P4 Tool (Bandit, Radon, Ruff)] as SA
}

package "Stage 3: RL-Verification (Core)" {
    component "LLM Test Generator" as Generator
    component "Test Executor (Pytest)" as Executor
    component "Reward Function" as Reward

    Generator -> Executor : "generates tests"
    Executor -> Reward : "coverage + bugs"
    Reward -> Generator : "RL feedback"
}

package "Stage 4: Reporting" {
    [Unified Quality Report] as QR
}

JA --> SA
SA --> Generator
Reward --> QR
@enduml