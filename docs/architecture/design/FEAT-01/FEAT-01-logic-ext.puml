@startuml
!define STAGE1 #DDEEFF
skinparam sequence {
    ParticipantBackgroundColor STAGE1
    ParticipantBorderColor #0066CC
}
title FEAT-01: Multi-Source Ingestion Manager

participant "IngestionManager" as IM
participant "Git/Zip Utility" as UTIL << (U,STAGE1) >>
participant "Adapters" as AD << (A,STAGE1) >>

[-> IM : collect(path_or_url)
activate IM STAGE1

alt is_url
    IM -> UTIL : git_clone(url)
else is_zip
    IM -> UTIL : extract_zip(path)
end

IM -> AD : recursive_scan(temp_dir)
AD --> IM : List<CodeUnit>
[<-- IM : List<CodeUnit>
deactivate IM
@enduml