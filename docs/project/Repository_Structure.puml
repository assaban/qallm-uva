@startuml
title qallm-uva: Repository Structure

package "qallm-uva (Root)" {
    [pyproject.toml] <<Config>>
    package "qallm" {
        package "ingestion" {
            [parsers.py]
            [context.py]
        }
        package "stage1_qqe" {
            note right: Quantitative Quality Engine
            [metrics.py]
            [normalizer.py]
        }
        package "stage2_lre" {
            note right: LLM Refinement Engine
            [prompter.py]
            [refiner.py]
        }
        package "core" {
            [orchestrator.py]
        }
    }
    package "tests" {
        [test_ingestion.py]
        [test_metrics.py]
    }
}
@enduml